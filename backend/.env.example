DATABASE_URL="postgresql://postgres:postgres@localhost:5432/budget_control?schema=public"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# --- Telegram ---
TELEGRAM_BOT_TOKEN="your-bot-token"
# Botning username'i (@ siz). Bo'sh qoldirilsa getMe orqali aniqlanadi.
TELEGRAM_BOT_USERNAME="myBudgetControl_bot"

# --- Ilova egasi ---
# Quyidagilardan bittasi mos kelsa ham foydalanuvchi ADMIN bo'ladi.
ALLOWED_PHONE="+998997162616"
ALLOWED_USERNAME="anvarov_bobur"
ALLOWED_TELEGRAM_ID=""

# "owner" (default, agar ALLOWED_* to'ldirilgan bo'lsa) -> faqat ilova egasi
#   ro'yxatdan o'ta oladi. Begonalar rad etiladi.
# "public" -> hamma ro'yxatdan o'ta oladi.
REGISTRATION_MODE="owner"

# Mini app va webhook manzili (https://...)
WEBAPP_URL="https://your-app.up.railway.app"
FRONTEND_URL="https://your-app.up.railway.app"
PORT=3000

# Daily pg_dump (03:00 UTC). Mount a Railway volume at /app/backups.
BACKUP_ENABLED=1
BACKUP_DIR=/app/backups
BACKUP_RETENTION_DAYS=7
MAINTENANCE_KEY="change-me-long-random-secret"

# DIQQAT: RESET_DB o'zgaruvchisini QO'YMANG.
# Ilgari u har deployda butun bazani o'chirib yuborardi. Endi e'tiborga
# olinmaydi, lekin Railway -> Variables da qolgan bo'lsa o'chirib tashlang.
